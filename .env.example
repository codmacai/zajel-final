# EASIEST: copy Zajel-2's .env into this folder unchanged — the VITE_* names are accepted.
#   copy ..\Zajel-2\.env .env
# .env* files are gitignored. zajel-final is a PUBLIC repo — never commit real keys.
#
# Without any config the app already talks to the same APIs as the React app:
#   - next dev:   /services/prepaid  -> proxied to your local API at https://localhost:7115
#                 (self-signed dev cert accepted, like Vite's secure:false)
#   - production: https://api.zajel.com/services/prepaid
#   - tracking:   https://api.zajel.com/services/mobileapp/... via /api/track (server-side)
# Only the two keys below are required.

# Google Maps browser key (Places + Static Maps). Also accepted as VITE_GOOGLE_MAPS_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# YARP X-AUTH-API-KEY for tracking (server-only). Also accepted as VITE_YARP_API_KEY.
YARP_API_KEY=

# Dev against the live API instead of localhost:7115:
# PREPAID_API_PROXY_TARGET=https://api.zajel.com

# Staging/UAT (replaces `npm run build:staging`): uncomment both.
# NEXT_PUBLIC_API_BASE_URL=https://api-stg.zajel.com:7861/services/prepaid
# PREPAID_API_PROXY_TARGET=https://api-stg.zajel.com:7861

# Set to 1 to log the payment polling flow to the browser console in production builds.
# NEXT_PUBLIC_DEBUG_PAYMENTS=1
